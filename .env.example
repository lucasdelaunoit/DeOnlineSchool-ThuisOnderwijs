RESEND_API_KEY=
MAIL_TO=paulhenri@pauldepierre.com
MAIL_FROM=noreply@de-online-school.be

# Moderation links in the reaction mails. A long random string (at least 32 characters),
# e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it makes the links in older mails stop working.
MODERATION_SECRET=
# Public address of the site, used in those links. Falls back to the request's host.
SITE_URL=
# SQLite file with reactions and the search index. Must be on a disk that survives
# deploys, outside public/. Default: data/site.db
DATABASE_PATH=
