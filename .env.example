RESEND_API_KEY=
MAIL_TO=paulhenri@pauldepierre.com
MAIL_FROM=noreply@de-online-school.be

# Moderation links for reactions (`npm run reactions`). A long random string (at least 32
# characters), e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it makes older links stop working.
MODERATION_SECRET=
# Public address of the site, used in those links and by `npm run questions` to refresh
# the site after a change. Moderation links fall back to http://localhost:3000.
SITE_URL=
# Lets `npm run questions -- import/delete` refresh the pages (POST /api/revalidate).
# A long random string, at least 32 characters, made the same way as MODERATION_SECRET.
REVALIDATE_SECRET=
# SQLite file with the questions, their search index and the reactions. Must be on a disk that survives
# deploys, outside public/. Default: data/site.db
DATABASE_PATH=
